# Copy to .env; this example contains no credentials.
# Working data folder (equivalent to the global CLI --data option).
RUSTCLIP_DATA=data
RUST_LOG=rustclip_studio=info

# Linux/macOS: leave commented to discover installed tools from PATH.
# Windows: uncomment and set real paths including the .exe extension.
# RUSTCLIP_FFMPEG='C:/tools/ffmpeg/bin/ffmpeg.exe'
# RUSTCLIP_FFPROBE='C:/tools/ffmpeg/bin/ffprobe.exe'
# RUSTCLIP_ESPEAK='C:/tools/espeak-ng/espeak-ng.exe'

# Optional local neural RU voice: Piper 1.8.0 + ru_RU-denis-medium.
# Installation and separate engine/model licenses: docs/voice.md.
# Use real absolute paths to your project; do not copy the example folder name.
# Windows Python venv:
# RUSTCLIP_PIPER='C:/projects/rustclip-studio/.venv/Scripts/piper.exe'
# PIPER_MODEL='C:/projects/rustclip-studio/data/voices/ru_RU-denis-medium.onnx'
# Linux Python venv:
# RUSTCLIP_PIPER='/home/you/rustclip-studio/.venv/bin/piper'
# PIPER_MODEL='/home/you/rustclip-studio/data/voices/ru_RU-denis-medium.onnx'
# Keep ru_RU-denis-medium.onnx.json beside its matching .onnx file.
# Optional explicit matching config; otherwise Piper uses the adjacent file:
# PIPER_CONFIG='C:/projects/rustclip-studio/data/voices/ru_RU-denis-medium.onnx.json'

# Optional local script generation, enabled explicitly in the interface.
# Only localhost / loopback addresses are accepted. No paid cloud API.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional public YouTube mostPopular metadata (Google Trends needs no key).
# YOUTUBE_API_KEY=

# Manual OAuth access token for your channel: youtube.upload scope.
# No built-in OAuth setup or token refresh. Never commit a real token.
# YOUTUBE_ACCESS_TOKEN=

# Optional analytics token: yt-analytics.readonly;
# revenue also needs yt-analytics-monetary.readonly.
# YOUTUBE_ANALYTICS_ACCESS_TOKEN=

# Optional bot publication to an explicitly selected chat/channel.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
